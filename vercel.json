{
  "bunVersion": "1.x",
  "rewrites": [
    {
      "source": "/Logo/(.*)",
      "destination": "/public/Logo/$1"
    },
    {
      "source": "/MenuImages/(.*)",
      "destination": "/public/MenuImages/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/public/favicon.ico"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}